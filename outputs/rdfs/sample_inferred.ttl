"Daily aggregate of clicks, not an individual click or study duration." a rdfs:Resource .

"Module" a rdfs:Resource .

"Module presentation (course offering)" a rdfs:Resource .

"Person" a rdfs:Resource .

"Recorded assessment result; may be banked from a previous presentation. Not necessarily a new submission." a rdfs:Resource .

"Student" a rdfs:Resource .

"Student enrollment in one offering" a rdfs:Resource .

20.0 a rdfs:Resource,
        xsd:decimal .

<https://example.org/oulad/id/offering/AAA/2013J> a rdfs:Resource,
        edu:CourseOffering .

xsd:decimal a rdfs:Resource .

xsd:string a rdfs:Resource .

xsd:integer a rdfs:Resource .

rdfs:Class a rdfs:Resource .

rdf:Property a rdfs:Resource .

