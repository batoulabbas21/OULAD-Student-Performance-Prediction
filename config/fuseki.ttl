@prefix fuseki: <http://jena.apache.org/fuseki#> .
@prefix tdb2: <http://jena.apache.org/2016/tdb#> .

# Keep the existing lab dataset in its original persistent location.
<#lab> a fuseki:Service ;
    fuseki:name "kr" ;
    fuseki:serviceQuery "sparql", "query", "" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceUpload "upload" ;
    fuseki:serviceReadGraphStore "get" ;
    fuseki:serviceReadWriteGraphStore "data", "" ;
    fuseki:dataset <#lab-store> .

<#lab-store> a tdb2:DatasetTDB2 ; tdb2:location "/data/kr" .

# Separate persistent project dataset. No automatic RDFS reasoner is configured.
<#oulad> a fuseki:Service ;
    fuseki:name "oulad" ;
    fuseki:serviceQuery "sparql", "query", "" ;
    fuseki:serviceUpdate "update" ;
    fuseki:serviceUpload "upload" ;
    fuseki:serviceReadGraphStore "get" ;
    fuseki:serviceReadWriteGraphStore "data", "" ;
    fuseki:dataset <#oulad-store> .

<#oulad-store> a tdb2:DatasetTDB2 ; tdb2:location "/data/oulad" .
