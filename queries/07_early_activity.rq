PREFIX edu: <https://example.org/oulad/schema#>
# Requires subset --activity. Project window is days 0 through 27, inclusive.
SELECT ?enrollment (SUM(?clicks) AS ?clickCount) (COUNT(DISTINCT ?resource) AS ?resourceCount)
WHERE {
  ?interaction edu:interactionForEnrollment ?enrollment ; edu:withResource ?resource ;
               edu:interactionDay ?day ; edu:clickCount ?clicks .
  FILTER (?day >= 0 && ?day < 28)
} GROUP BY ?enrollment ORDER BY DESC(?clickCount)
